{
  "name": "quackery-opencode",
  "version": "0.1.0",
  "description": "Git-native recursively parallel implementation plugin for OpenCode",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".quack/config.jsonc",
    ".quack/config.local.example.jsonc"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json",
    "test": "bun test tests",
    "test:coverage": "bun test tests --coverage",
    "verify": "bun run check && bun test tests && bun run build",
    "prepublishOnly": "bun run verify"
  },
  "dependencies": {
    "@bytecodealliance/jco": "1.32.1",
    "@opencode-ai/plugin": "1.18.23",
    "@opencode-ai/sdk": "1.18.23",
    "jsonc-parser": "3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
