{
  "name": "quackery-opencode",
  "version": "0.1.2",
  "description": "Git-native recursively parallel implementation plugin for OpenCode",
  "keywords": [
    "opencode",
    "plugin",
    "multi-agent",
    "orchestration",
    "git-worktree",
    "wit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medicalissue/Quackery.git"
  },
  "homepage": "https://github.com/medicalissue/Quackery#readme",
  "bugs": {
    "url": "https://github.com/medicalissue/Quackery/issues"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    ".quack/config.jsonc",
    ".quack/config.local.example.jsonc"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json",
    "test": "bun test tests",
    "test:coverage": "bun test tests --coverage",
    "verify": "bun run check && bun test tests && bun run build",
    "prepublishOnly": "bun run verify"
  },
  "dependencies": {
    "@bytecodealliance/jco": "1.32.1",
    "@opencode-ai/plugin": "1.18.23",
    "@opencode-ai/sdk": "1.18.23",
    "jsonc-parser": "3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
